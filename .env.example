# Пример окружения для compose.yaml.
# Скопировать и подставить свои значения: cp .env.example .env
# Сам .env в репозиторий не коммитится (см. .gitignore) — на сервере он лежит руками.

POSTGRES_USER=<пользователь>
POSTGRES_PASSWORD=<пароль>
POSTGRES_DB=schedule

REDIS_USER_PASSWORD=<пароль>

MINIO_ROOT_USER=<пользователь>
MINIO_ROOT_PASSWORD=<пароль> # должен содержать цифры, специальные символы и регистр
MINIO_WEBHOOK_AUTH_TOKEN="Bearer <токен>" # выдаётся minio-generate-keys.sh, см. minio-*-init-webhook.sh

PGADMIN_DEFAULT_EMAIL=<почта>
PGADMIN_DEFAULT_PASSWORD=<пароль>

CLICKHOUSE_USER=<пользователь>
CLICKHOUSE_PASSWORD=<пароль>

# в production поменять все ссылки на доменное имя
HYPERDX_API_URL=http://hyperdx-ui
HYPERDX_API_PORT=8000
HYPERDX_APP_URL=http://hyperdx-ui
HYPERDX_APP_PORT=8081
# FRONTEND_URL=<URL> - ссылка на полное доменное имя 
# HYPERDX_BASE_PATH=/ (без url)
# NEXT_PUBLIC_HYPERDX_BASE_PATH=/hyperdx (без url)
 
MINIO_SERVER_URL=http://minio:9000 
MINIO_BROWSER_REDIRECT_URL=http://minio:9001 # http://minio:9001/console - если production 

GF_SECURITY_ADMIN_USER=<пользователь>
GF_SECURITY_ADMIN_PASSWORD=<пароль>
